<%= form_with(model: listing, class: "contents") do |form| %>
  <% if listing.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(listing.errors.count, "error") %> prohibited this listing from being saved:</h2>

      <ul class="list-disc ml-6">
        <% listing.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title %>
    <%= form.text_field :title, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": listing.errors[:title].none?, "border-red-400 focus:outline-red-600": listing.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :address %>
    <%= form.text_field :address, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": listing.errors[:address].none?, "border-red-400 focus:outline-red-600": listing.errors[:address].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :address %>
    <%= form.text_field :address, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": listing.errors[:address].none?, "border-red-400 focus:outline-red-600": listing.errors[:address].any?}] %>
  </div>
<div class="flex grid-cols-3 gap-8">
  <div >
    <%= form.label :bedrooms %>
    <%= form.number_field :bedrooms, min: 1, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": listing.errors[:bedrooms].none?, "border-red-400 focus:outline-red-600": listing.errors[:bedrooms].any?}] %>
  </div>
  <div >
    <%= form.label :bathrooms %>
    <%= form.number_field :bathrooms, min: 1, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": listing.errors[:bathrooms].none?, "border-red-400 focus:outline-red-600": listing.errors[:bathrooms].any?}] %>
  </div>
  <div >
    <%= form.label :people_limit %>
    <span class="text-sm">(1 per bedroom)</span>
    <%= form.number_field :people_limit, min: 1, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": listing.errors[:people_limit].none?, "border-red-400 focus:outline-red-600": listing.errors[:people_limit].any?}] %>
  </div>
</div>

  <div class="my-5">
    <%= form.label :images %>
    <%= form.file_field :images, multiple: true,
      class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": listing.errors[:images].none?, "border-red-400 focus:outline-red-600": listing.errors[:images].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
