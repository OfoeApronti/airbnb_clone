<div class="flex flex-col space-y-2 max-w-4xl mx-auto w-full">
    <%= link_to "Back to listing", listing_path, class: "bg-gray-100 rounded-lg border-2 border-gray-900 mr-auto p-2" %>
  <div class="grid grid-cols-4 gap-4">
    <% @listing.images.each do |image| %>
        <%= image_tag image, class: "w-36 h-36 object-cover" %>
    <% end %>
  </div>

</div>
