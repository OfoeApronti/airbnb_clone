<div class="flex flex-col space-y-2 max-w-3xl w-full  mx-auto">
    <div class="flex justify-between items-center">
    <%= link_to "Back to all listings", listings_path, class: "bg-gray-100 rounded-lg border-2 border-gray-900 mr-auto p-2" %>
    <%= link_to "Edit listing", edit_listing_path(@listing) %>
    </div>
    <% if @listing.images.any? %>
<div class="flex gap-8 rounded-lg overflow-hidden relative">
  <%= image_tag @listing.images.first, class: "w-80 h-80" %>
    <div class="grid grid-cols-2 gap-8 flex-wrap">
        <% @listing.images[1..4].each do |image| %>
          <%= image_tag image, class: "h-36 " %>
        <% end %>
    </div>
    <%= link_to "Show all photos", photos_listing_path(@listing), class: "absolute top-4 left-4 bg-white rounded-lg p-2" %>
</div>
<% end %>
<h1 class="font-semibold">
<%= @listing.title %>
</h1>
<%= @listing.description %>

<div class="flex grid-cols-3 gap-8">
   <div class="shadow-lg bg-gray-100 h-40 w-40 flex flex-col items-center justify-center">
       <!--
       <svg width="48" height="48" viewBox="0 0 48 48">
         <g fill="none" stroke="currentColor" stroke-width="4">
