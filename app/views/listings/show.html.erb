           <path stroke-linecap="round" stroke-linejoin="round" d="M33.999 22V5a1 1 0 0 0-1-1h-18a1 1 0 0 0-1 1v17"/>
           <path d="M6.08 22.364A.3.3 0 0 1 6.372 22h35.254a.3.3 0 0 1 .292.364c-1.224 5.508-4.635 10.452-10 12.2C29.436 35.374 26.656 36 24 36s-5.436-.627-7.92-1.436c-5.365-1.749-8.776-6.692-10-12.2Z"/>
         </g>
       </svg>
       -->
       <%= image_tag "toilet.svg", alt: "Toilet" %>
       <span class="text-2xl">
       <%= @listing.bathrooms %>
       </span>
   </div>

</div>
</div>
